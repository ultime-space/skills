{
  "name": "@ultime/codecraft",
  "version": "1.13.0",
  "description": "面向 JS/TS 的代码规范与架构设计（前端与 JS/TS 后端分轨），作为可安装的 skill 包。",
  "keywords": [
    "ai",
    "code-standard",
    "lint",
    "skill",
    "audit",
    "architecture",
    "review",
    "scaffold",
    "agent-skills"
  ],
  "author": "UltimeLam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultime-space/skills.git",
    "directory": "skills/codecraft"
  },
  "homepage": "https://github.com/ultime-space/skills/tree/main/skills/codecraft",
  "bugs": {
    "url": "https://github.com/ultime-space/skills/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "codecraft": "bin/codecraft.mjs"
  },
  "files": [
    "SKILL.md",
    "bin",
    "src",
    "docs",
    "scenarios",
    "adapters",
    "prompts",
    "evals",
    "templates",
    "VERSION",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "codecraft.config.example.json"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "eval": "node evals/run.mjs",
    "self-check": "node bin/codecraft.mjs check --root . --pack design-system --exclude \"evals/fixtures/**\" --ci",
    "release-check": "node scripts/release-check.mjs",
    "prepublishOnly": "npm test && npm run release-check && npm run self-check"
  },
  "engines": {
    "node": ">=20"
  }
}
